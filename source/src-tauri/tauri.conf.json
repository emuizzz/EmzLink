{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmzLink",
  "version": "1.0.0",
  "identifier": "com.emzlink.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EmzLink",
        "width": 980,
        "height": 640,
        "resizable": true,
        "minWidth": 760,
        "minHeight": 520,
        "maximizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}